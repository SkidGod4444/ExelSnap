{
  "name": "exelsnap",
  "productName": "ExelSnap",
  "version": "0.1.0",
  "description": "Chat with your spreadsheets, fully offline — powered by SAPIENT.",
  "main": "./out/main/index.js",
  "author": "Shubhr Gunjan",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "agent:cli": "electron-vite build && node out/main/cli.js",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "snap": "electron-vite build && electron scripts/snap.cjs snaps",
    "sample": "node scripts/make-sample.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "typescript": "5.9",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.63",
    "@duckdb/node-api": "^1.5.6-r.1",
    "ai": "^7.0.128",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "dev.exelsnap.app",
    "productName": "ExelSnap",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@duckdb/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "darkModeSupport": true,
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "fileAssociations": [
      {
        "ext": [
          "xlsx",
          "xlsm",
          "xlsb",
          "xls",
          "ods",
          "csv",
          "tsv"
        ],
        "name": "Spreadsheet",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
